# Copy to .env with `cp .env.example .env`. NEVER commit .env: it is git-ignored.
# Only the Gemini comparison uses the key. The tests, the grader, training, the export and the app never do.
# Gemini's free tier may keep what you send: send dataset photos only, never shelter or user photos.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
